{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "../",
    "outDir": "../node_modules/.tmp/server-types",
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "../src/data/types.ts",
    "../src/data/meta.ts",
    "../src/data/selectors.ts",
    "../src/data/DataSource.ts",
    "../src/data/rules/*.ts",
    "../src/office/layout.ts"
  ]
}
